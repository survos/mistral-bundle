{
  "name": "survos/mistral-bundle",
  "description": "Typed Mistral Files, OCR and Batch clients with Symfony configuration and caching.",
  "type": "symfony-bundle",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "softcreatr/php-mistral-ai-sdk": "^5.1",
    "survos/fetch-bundle": "^2.45",
    "survos/kit-bundle": "^2.6",
    "nyholm/psr7": "^1.8",
    "symfony/cache-contracts": "^3.6|^4.0",
    "symfony/config": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/http-client": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/mime": "^8.1"
  },
  "require-dev": {"phpunit/phpunit": "^13.0", "symfony/cache": "^8.1", "symfony/framework-bundle": "^8.1"},
  "autoload": {"psr-4": {"Survos\\MistralBundle\\": "src/"}},
  "autoload-dev": {"psr-4": {"Survos\\MistralBundle\\Tests\\": "tests/"}},
  "scripts": {"test": "phpunit"}
}
